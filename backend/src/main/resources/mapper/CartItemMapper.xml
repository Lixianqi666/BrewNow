<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.brewnow.mapper.CartItemMapper">

    <!-- 购物车项结果映射 -->
    <resultMap id="cartItemResultMap" type="com.brewnow.entity.CartItem">
        <id property="cartItemId" column="cart_item_id"/>
        <result property="cartId" column="cart_id"/>
        <result property="productId" column="product_id"/>
        <result property="quantity" column="quantity"/>
        <result property="addTime" column="add_time"/>
    </resultMap>

    <!-- 购物车项结果映射（包含商品信息） -->
    <resultMap id="cartItemWithProductResultMap" type="com.brewnow.entity.CartItem">
        <id property="cartItemId" column="cart_item_id"/>
        <result property="cartId" column="cart_id"/>
        <result property="productId" column="product_id"/>
        <result property="quantity" column="quantity"/>
        <result property="addTime" column="add_time"/>
        <association property="product" javaType="com.brewnow.entity.Product">
            <id property="productId" column="product_id"/>
            <result property="merchantId" column="merchant_id"/>
            <result property="productName" column="product_name"/>
            <result property="brand" column="brand"/>
            <result property="category" column="category"/>
            <result property="price" column="price"/>
            <result property="stockQuantity" column="stock_quantity"/>
            <result property="compatibleDevices" column="compatible_devices"/>
            <result property="description" column="description"/>
            <result property="imageUrl" column="image_url"/>
            <result property="status" column="status"/>
        </association>
    </resultMap>

    <!-- 基础SQL片段 -->
    <sql id="cartItemColumns">
        cart_item_id, cart_id, product_id, quantity, add_time
    </sql>

    <!-- 根据购物车ID查询所有购物车项（包含商品信息） -->
    <select id="selectByCartId" resultMap="cartItemWithProductResultMap">
        SELECT ci.cart_item_id, ci.cart_id, ci.product_id, ci.quantity, ci.add_time,
               p.merchant_id, p.product_name, p.brand, p.category, p.price, 
               p.stock_quantity, p.compatible_devices, p.description, p.image_url, p.status
        FROM cart_items ci
        LEFT JOIN products p ON ci.product_id = p.product_id
        WHERE ci.cart_id = #{cartId}
        ORDER BY ci.add_time DESC
    </select>

    <!-- 根据购物车ID和商品ID查询购物车项 -->
    <select id="selectByCartIdAndProductId" resultMap="cartItemResultMap">
        SELECT <include refid="cartItemColumns"/>
        FROM cart_items
        WHERE cart_id = #{cartId} AND product_id = #{productId}
    </select>

    <!-- 添加购物车项 -->
    <insert id="insert" parameterType="com.brewnow.entity.CartItem" useGeneratedKeys="true" keyProperty="cartItemId">
        INSERT INTO cart_items (cart_id, product_id, quantity, add_time)
        VALUES (#{cartId}, #{productId}, #{quantity}, #{addTime})
    </insert>

    <!-- 更新购物车项数量 -->
    <update id="updateQuantity">
        UPDATE cart_items
        SET quantity = #{quantity}
        WHERE cart_item_id = #{cartItemId}
    </update>

    <!-- 删除购物车项 -->
    <delete id="deleteById">
        DELETE FROM cart_items WHERE cart_item_id = #{cartItemId}
    </delete>

    <!-- 根据购物车ID删除所有购物车项 -->
    <delete id="deleteByCartId">
        DELETE FROM cart_items WHERE cart_id = #{cartId}
    </delete>

    <!-- 统计购物车中商品数量 -->
    <select id="countByCartId" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM cart_items
        WHERE cart_id = #{cartId}
    </select>

</mapper> 