# 沏刻茶叶电商平台环境变量配置文件
# 复制为 .env 文件使用

# ========================
# 数据库配置
# ========================

# MySQL 数据库配置
MYSQL_ROOT_PASSWORD=200306
MYSQL_DATABASE=brew-now
MYSQL_USER=brewnow_user
MYSQL_PASSWORD=brewnow_pass

# ========================
# MinIO 对象存储配置
# ========================

# MinIO 访问凭据
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DEFAULT_BUCKETS=brew-now

# ========================
# 后端服务配置
# ========================

# Spring Boot 数据库连接
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/brew-now?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=200306

# MinIO 连接配置
SPRING_MINIO_ENDPOINT=http://minio:9000
SPRING_MINIO_ACCESS_KEY=minioadmin
SPRING_MINIO_SECRET_KEY=minioadmin
SPRING_MINIO_BUCKET=brew-now

# 后端 application.yml 实际读取的 MinIO 变量（推荐使用）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://localhost/minio
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=brew-now

# JWT 密钥（生成新的：openssl rand -base64 32）
JWT_SECRET=your-jwt-secret-key-here

# ========================
# 前端服务配置
# ========================

# 前端 API 代理配置
VITE_API_BASE_URL=/api

# ========================
# Nginx 反向代理配置
# ========================

# Nginx 站点域名（无域名可使用 localhost）
NGINX_SERVER_NAME=localhost

# 前端构建产物目录（对应 nginx 配置中的 root）
NGINX_FRONTEND_DIST=/opt/brew-now/frontend/dist

# ========================
# 其他配置
# ========================

# 时区设置
TZ=Asia/Shanghai

# 日志级别
LOG_LEVEL=INFO

# 调试模式
DEBUG=false